    {
      "id": "nutrition_cases_01",
      "filename": "Meal Plan cho các trường hợp.docx",
      "sourceFileSha256": "0b349a33ba4e476e58348065086b9f6a284032165c00a22ee82ca8fd9efa2d4d",
      "sourceKind": "user_supplied_docx",
      "verified": false,
      "reviewStatus": "needs_review",
      "paragraphCount": 131,
      "paragraphs": [
        {
          "index": 1,
          "text": "Dưới đây là các cấu trúc Meal Plan chi tiết cho 5 trường hợp mục tiêu khác nhau, được xây dựng dựa trên nguyên tắc dinh dưỡng khoa học từ Hệ thống Phòng khám Dinh dưỡng Nutrihome và Hệ thống Y tế Vinmec. Format được thiết kế tương đồng với mẫu bạn đã cung cấp để dễ dàng áp dụng trực tiếp cho học viên.",
          "redaction": null,
          "unresolvedCitationMarkers": []
        },
        {
          "index": 2,
          "text": "1. Meal Plan: Tăng cân (Dư thừa Calo an toàn)",
          "redaction": null,
          "unresolvedCitationMarkers": []
        },
        {
          "index": 3,
          "text": "Dựa trên hướng dẫn dinh dưỡng tăng cân lành mạnh, ưu tiên thực phẩm giàu đạm, tinh bột nhanh/chậm và chất béo tốt.",
          "redaction": null,
          "unresolvedCitationMarkers": []
        },
        {
          "index": 4,
          "text": "Meal plan : Học viên nam (Mục tiêu tăng cân, tăng cơ)",
          "redaction": null,
          "unresolvedCitationMarkers": []
        },
        {
          "index": 5,
          "text": "~2700 calo chưa tính sai số do gia vị và rau. (Calo đã thặng dư)",
          "redaction": null,
          "unresolvedCitationMarkers": []
        },
        {
          "index": 6,
          "text": "BMR: 1750 (mức năng lượng duy trì sự sống).",
          "redaction": null,
          "unresolvedCitationMarkers": []
        },
        {
          "index": 7,
          "text": "Note:",
          "redaction": null,
          "unresolvedCitationMarkers": []
        },
        {
          "index": 8,
          "text": "Cân tất cả là đồ sống trừ cơm.",
          "redaction": null,
          "unresolvedCitationMarkers": []
        },
        {
          "index": 9,
          "text": "Nước: 2500 - 3000ml/ngày.",
          "redaction": null,
          "unresolvedCitationMarkers": []
        },
        {
          "index": 10,
          "text": "Cardio: 15-20p/ngày (nhịp tim 110-120) chủ yếu để khởi động và tăng cường trao đổi chất, không lạm dụng cardio cường độ cao.",
