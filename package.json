{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/src/index.ts",
    "build": "vite build && esbuild server/src/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "build:index": "tsx scripts/build_index.ts",
    "eval:rag": "tsx scripts/eval_rag.ts",
    "backfill:owner": "tsx scripts/backfill_owner_field.ts",
    "migrate:storage": "tsx scripts/migrate_csv_to_firestore.ts",
    "lint": "tsc --noEmit",
    "dev:client": "vite",
    "dev:server": "tsx server/src/index.ts",
    "test:training": "node --import tsx --test tests/training/domain.test.ts tests/training/service.test.ts tests/training/router.test.ts",
    "typecheck:training": "tsc -p tsconfig.training.json --noEmit",
    "test:training:emulator": "node --import tsx --test tests/training/emulator.integration.ts",
    "test:training:ui:server": "NODE_ENV=test node --import tsx tests/training/ui-server.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "csv-parse": "^7.0.2",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "three": "^0.186.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react-dom": "19.0.2",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
