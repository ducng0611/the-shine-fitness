ADMIN_EMAIL=
ADMIN_EMAILS=
FIREBASE_API_KEY=
GEMINI_API_KEY=
GMAIL_APP_PASSWORD=
RAG_ENABLED=
SMTP_HOST=
SMTP_PASS=
SMTP_PORT=
SMTP_USER=
STORAGE_BACKEND=

# Step 3: enable only on a reviewed staging environment.
SHINE_TRAINING_ENABLED=false
VITE_SHINE_TRAINING_ENABLED=false
# Explicit Firebase UIDs admitted to the pilot, not emails or membership codes.
SHINE_TRAINING_PILOT_UIDS=
# Optional: a model available to your Gemini account. Blank uses rules for intents.
SHINE_TRAINING_INTENT_MODEL=

# Source-case ingestion is isolated and off by default.
SHINE_PATHWAY_INTAKE_ENABLED=false
VITE_SHINE_PATHWAY_INTAKE_ENABLED=false

# Nutrition sources: admin read/preview only, no diet approval or member writes
SHINE_NUTRITION_SOURCE_REVIEW_ENABLED=false

# Phases 1-2: unified guest/member chat. Roll out on staging first.
# Frontend flag needs a rebuild; backend flag must also be true.
SHINE_CHAT_ENABLED=false
VITE_SHINE_CHAT_ENABLED=false
# Private reads additionally require training enabled, verified email, pilot access and consent.
SHINE_CHAT_MEMBER_CONTEXT_ENABLED=false
# Server-only model selection; fallback blank means no second model attempt.
SHINE_CHAT_MODEL=gemini-3.5-flash-lite
SHINE_CHAT_FALLBACK_MODEL=
SHINE_CHAT_TIMEOUT_MS=12000
# These flags DO NOT approve historical programs, equipment or meal plans.

# Separate loopback-only Local Pilot; npm run local:start -- --local
# No Firebase fallback. Private DB path and QA password must stay out of Git.
SHINE_LOCAL_ALLOW_MODEL=false
SHINE_LOCAL_PORT=4176
# SHINE_LOCAL_DB=/absolute/private/path/shine-pilot.sqlite

# SHINE_COMPANION_PILOT - disabled by default; review docs before enabling.
SHINE_COMPANION_ENABLED=false
VITE_SHINE_COMPANION_ENABLED=false
# Select a model actually available in your Gemini project. Never expose server keys via VITE_*.
SHINE_GEMINI_MODEL=
USDA_FDC_API_KEY=
GOOGLE_PLACES_API_KEY=
