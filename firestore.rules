rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Member Progress tracking
    match /member_progress/{progressId} {
      allow read: if true;
      allow create: if isValidId(progressId) && request.resource.data.userId is string;
      allow update, delete: if isValidId(progressId);
    }

    // Registration for trial / consultation
    match /registrations/{regId} {
      allow read: if true;
      allow create: if isValidId(regId);
      allow update, delete: if true;
    }

    // Health and fitness assessment
    match /health_assessments/{assessmentId} {
      allow read: if true;
      allow create: if isValidId(assessmentId);
      allow update, delete: if true;
    }

    // Check-in records at reception
    match /check_ins/{checkInId} {
      allow read: if true;
      allow create, update, delete: if isValidId(checkInId);
    }

    // Workout logs
    match /workout_logs/{logId} {
      allow read: if true;
      allow create, update, delete: if isValidId(logId);
    }

    // Gym packages
    match /packages/{packageId} {
      allow read: if true;
      allow write: if true;
    }

    // Promotional vouchers & campaigns
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if true;
    }

    // Marketing email flows
    match /email_campaigns/{campaignId} {
      allow read: if true;
      allow write: if true;
    }

    // Member profiles
    match /members/{memberId} {
      allow read: if true;
      allow write: if isValidId(memberId);
    }

    // Customers CRM
    match /customers/{customerId} {
      allow read: if true;
      allow write: if isValidId(customerId);
    }

    // Admin profiles
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isValidId(adminId);
    }
  }
}
