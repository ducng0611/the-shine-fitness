# Production defaults, committed on purpose so "Import from GitHub → Publish" works
# without manual setup. NOT for secrets: API keys and passwords go only in
# AI Studio → Settings → Secrets. Any value set there overrides this file.
# VITE_* lines are read at build time; the rest are read by the server at start.

# Member assistant (Shine Companion + AI Gym Buddy Q&A). Guests keep the service chatbot.
VITE_SHINE_COMPANION_ENABLED=true
SHINE_COMPANION_ENABLED=true
VITE_SHINE_CHAT_ENABLED=true
SHINE_CHAT_ENABLED=true
SHINE_CHAT_MEMBER_CONTEXT_ENABLED=true
# Model for Companion message understanding and food photos (same default as AI Gym Buddy).
SHINE_GEMINI_MODEL=gemini-3.5-flash-lite

# Training workspace. "*" = every signed-in member with a verified email.
VITE_SHINE_TRAINING_ENABLED=true
SHINE_TRAINING_ENABLED=true
SHINE_TRAINING_PILOT_UIDS=*

# Admin-only intake tools for private source documents stay off.
VITE_SHINE_PATHWAY_INTAKE_ENABLED=false
SHINE_PATHWAY_INTAKE_ENABLED=false
SHINE_NUTRITION_SOURCE_REVIEW_ENABLED=false

# Cloud storage for chat logs and handover queue (CSV files are lost on restart).
STORAGE_BACKEND=firestore
RAG_ENABLED=true

# Accounts allowed into /admin and the "Quản trị gym" tab.
ADMIN_EMAILS=ducnguyen06112002@gmail.com,theshinefitness.cskh@gmail.com
