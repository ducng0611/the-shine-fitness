rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Booking & Free Trial passes
    match /registrations/{registrationId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Health, BMI & TDEE assessments
    match /health_assessments/{assessmentId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Member Profiles (OTP / Google / Email)
    match /members/{memberId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Gym Reception Check-in Logs
    match /check_ins/{checkInId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Daily Member Workout Logs (Sets, Reps, Weights)
    match /workout_logs/{logId} {
      allow read, create, update, delete: if true;
    }

    // Fitness Blog & News
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if false;
    }

    // Admin Users and Role-Based Access Control
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Gym Membership & Training Packages
    match /packages/{packageId} {
      allow read, write: if true;
    }

    // Promotional Campaigns & Discount Vouchers
    match /promotions/{promoId} {
      allow read, write: if true;
    }

    // Email Marketing Automation Flows & Sequences
    match /email_campaigns/{campaignId} {
      allow read, write: if true;
    }

    // Email Dispatch Simulation Logs
    match /email_logs/{logId} {
      allow read, write: if true;
    }

    // Customer CRM records
    match /customers/{customerId} {
      allow read, write: if true;
    }
  }
}
