ADMIN_EMAIL=
ADMIN_EMAILS=
FIREBASE_API_KEY=
GEMINI_API_KEY=
GMAIL_APP_PASSWORD=
RAG_ENABLED=
SMTP_HOST=
SMTP_PASS=
SMTP_PORT=
SMTP_USER=
STORAGE_BACKEND=

# Step 3: enable only on a reviewed staging environment.
SHINE_TRAINING_ENABLED=false
VITE_SHINE_TRAINING_ENABLED=false
# Explicit Firebase UIDs admitted to the pilot, not emails or membership codes.
SHINE_TRAINING_PILOT_UIDS=
# Optional: a model available to your Gemini account. Blank uses rules for intents.
SHINE_TRAINING_INTENT_MODEL=

# Source-case ingestion is isolated and off by default.
SHINE_PATHWAY_INTAKE_ENABLED=false
VITE_SHINE_PATHWAY_INTAKE_ENABLED=false

# Nutrition sources: admin read/preview only, no diet approval or member writes
SHINE_NUTRITION_SOURCE_REVIEW_ENABLED=false
