{
  "entities": {
    "MemberProgress": {
      "title": "MemberProgress",
      "description": "Progress entries tracked by gym members including weight, measurements, and reflections",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "memberCode": { "type": "string" },
        "date": { "type": "string" },
        "weightKg": { "type": "number" },
        "bodyFatPct": { "type": "number" },
        "muscleMassKg": { "type": "number" },
        "waistCm": { "type": "number" },
        "notes": { "type": "string" },
        "energyLevel": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "date", "weightKg"]
    },
    "Registration": {
      "title": "Registration",
      "description": "Customer registration for gym package trial or consultation",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "packageType": { "type": "string" }
      },
      "required": ["fullName", "phone"]
    },
    "HealthAssessment": {
      "title": "HealthAssessment",
      "description": "Health and fitness assessment for gym visitors",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "bmi": { "type": "number" },
        "tdee": { "type": "number" }
      },
      "required": ["fullName", "phone"]
    },
    "WorkoutLog": {
      "title": "WorkoutLog",
      "description": "Member workout and exercise session logs",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "workoutType": { "type": "string" },
        "durationMinutes": { "type": "number" }
      },
      "required": ["userId", "workoutType"]
    },
    "CheckIn": {
      "title": "CheckIn",
      "description": "QR and reception check-in records",
      "type": "object",
      "properties": {
        "memberCode": { "type": "string" },
        "memberName": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["memberCode"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer and lead records for CRM",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "memberCode": { "type": "string" }
      },
      "required": ["fullName"]
    },
    "Package": {
      "title": "Package",
      "description": "Gym membership package options",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" }
      },
      "required": ["name", "price"]
    },
    "Promotion": {
      "title": "Promotion",
      "description": "Promotions and discount vouchers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "discountPercent": { "type": "number" }
      },
      "required": ["title"]
    },
    "EmailCampaign": {
      "title": "EmailCampaign",
      "description": "Email automation flows and marketing campaigns",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "Member": {
      "title": "Member",
      "description": "Registered member profile and credentials",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "memberCode": { "type": "string" }
      },
      "required": ["uid", "fullName"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Administrator account credentials and roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "ChatLog": {
      "title": "ChatLog",
      "description": "Server-side chat conversation and performance audit logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "timestamp": { "type": "string" },
        "lang": { "type": "string" },
        "isMember": { "type": "boolean" },
        "userMessage": { "type": "string" },
        "botResponse": { "type": "string" },
        "latencyMs": { "type": "number" },
        "usedFallback": { "type": "boolean" },
        "handoverTag": { "type": "string" }
      },
      "required": ["id", "sessionId", "timestamp"]
    },
    "ChatFeedback": {
      "title": "ChatFeedback",
      "description": "Chatbot message thumbs up or thumbs down feedback ratings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "messageId": { "type": "string" },
        "feedback": { "type": "string", "enum": ["like", "dislike"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "sessionId", "feedback", "createdAt"]
    },
    "HandoverQueue": {
      "title": "HandoverQueue",
      "description": "Human consultant handover queue tickets and resolution records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string" },
        "sessionId": { "type": "string" },
        "tag": { "type": "string" },
        "summary": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "createdAt", "sessionId", "tag", "status"]
    },
    "GymZone": {
      "title": "GymZone",
      "description": "Physical zones and areas at The Shine Fitness facility",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "floor": { "type": "string" },
        "reviewStatus": { "type": "string", "enum": ["draft", "needs_review", "verified", "rejected"] },
        "verified": { "type": "boolean" },
        "revision": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "floor", "reviewStatus", "verified"]
    },
    "GymEquipment": {
      "title": "GymEquipment",
      "description": "Physical gym machines and equipment stations at The Shine Fitness",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "zoneId": { "type": "string" },
        "category": { "type": "string" },
        "operationalStatus": { "type": "string" },
        "isFunctional": { "type": "boolean" },
        "reviewStatus": { "type": "string", "enum": ["draft", "needs_review", "verified", "rejected"] },
        "verified": { "type": "boolean" },
        "revision": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "zoneId", "category", "operationalStatus", "isFunctional", "reviewStatus", "verified"]
    },
    "GymExercise": {
      "title": "GymExercise",
      "description": "Trainer-approved exercise catalogue mapped to The Shine equipment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "primaryMuscle": { "type": "string" },
        "difficulty": { "type": "string" },
        "reviewStatus": { "type": "string", "enum": ["draft", "needs_review", "verified", "rejected"] },
        "verified": { "type": "boolean" },
        "revision": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "category", "primaryMuscle", "difficulty", "reviewStatus", "verified"]
    },
    "GymCatalogueRevision": {
      "title": "GymCatalogueRevision",
      "description": "Audit trail and revision log for gym catalogue modifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "number" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "action": { "type": "string" },
        "changedBy": { "type": "string" },
        "changeSummary": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "version", "entityType", "entityId", "action", "changedBy", "changeSummary", "timestamp"]
    }
  },
  "firestore": {
    "/member_progress/{progressId}": {
      "schema": "#/entities/MemberProgress",
      "description": "Member fitness progress tracking records"
    },
    "/registrations/{regId}": {
      "schema": "#/entities/Registration",
      "description": "Public trial registrations"
    },
    "/health_assessments/{assessmentId}": {
      "schema": "#/entities/HealthAssessment",
      "description": "Health assessments"
    },
    "/workout_logs/{logId}": {
      "schema": "#/entities/WorkoutLog",
      "description": "Workout logs"
    },
    "/check_ins/{checkInId}": {
      "schema": "#/entities/CheckIn",
      "description": "Member check-in records"
    },
    "/customers/{customerId}": {
      "schema": "#/entities/Customer",
      "description": "CRM customer records"
    },
    "/packages/{packageId}": {
      "schema": "#/entities/Package",
      "description": "Gym membership packages"
    },
    "/promotions/{promoId}": {
      "schema": "#/entities/Promotion",
      "description": "Promotions and vouchers"
    },
    "/email_campaigns/{campaignId}": {
      "schema": "#/entities/EmailCampaign",
      "description": "Email marketing campaigns"
    },
    "/members/{memberId}": {
      "schema": "#/entities/Member",
      "description": "Member user profiles"
    },
    "/admins/{adminId}": {
      "schema": "#/entities/Admin",
      "description": "Admin accounts"
    },
    "/chat_logs/{logId}": {
      "schema": "#/entities/ChatLog",
      "description": "Server-side chat audit logs"
    },
    "/chat_feedback/{feedbackId}": {
      "schema": "#/entities/ChatFeedback",
      "description": "Chatbot message feedback"
    },
    "/handover_queue/{handoverId}": {
      "schema": "#/entities/HandoverQueue",
      "description": "Consultant handover queue tickets"
    },
    "/gym_zones/{zoneId}": {
      "schema": "#/entities/GymZone",
      "description": "Physical zones in the facility"
    },
    "/gym_equipment/{equipmentId}": {
      "schema": "#/entities/GymEquipment",
      "description": "Gym equipment and machine stations"
    },
    "/gym_exercises/{exerciseId}": {
      "schema": "#/entities/GymExercise",
      "description": "Trainer-approved exercises catalogue"
    },
    "/gym_catalogue_revisions/{revId}": {
      "schema": "#/entities/GymCatalogueRevision",
      "description": "Audit revisions of gym knowledge catalogue"
    }
  }
}
